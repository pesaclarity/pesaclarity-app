PESACLARITY_VAULT_URL=
PESACLARITY_GOOGLE_SERVER_CLIENT_ID=
PESACLARITY_PLAY_CLOUD_PROJECT=
PESACLARITY_PINNED_HOSTS=
PESACLARITY_TRUSTED_ROOTS=
PESACLARITY_RATES_URL=
PESACLARITY_RATES_SOURCE_NAME=
PESACLARITY_RATES_SOURCE_URL=
