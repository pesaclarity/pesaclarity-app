{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand":      { "$value": "#C8102E", "$description": "Pesa Red. Hero cards, active tab, primary buttons. White text on it: 5.9:1." },
    "brandLink":  { "$value": "#B81D2F", "$description": "Links and alerts on white (6.5:1)." },
    "brandSoft":  { "$value": "#FDECEE", "$description": "Selected rows, chips, subtle fills." },
    "background": { "$value": "#FBF8F8" },
    "surface":    { "$value": "#FFFFFF" },
    "border":     { "$value": "#EFE6E7" },
    "text":       { "$value": "#1C1215" },
    "textMuted":  { "$value": "#6F6064", "$description": "5.6:1 on background." },
    "success":    { "$value": "#059669", "$description": "Fills and icons. For success text on white use successText." },
    "successText":{ "$value": "#047857" },
    "warning":    { "$value": "#B45309" },
    "danger":     { "$value": "#C8102E", "$description": "Same red as brand; always pair with an icon or label (\"Over\")." }
  },
  "dark": {
    "background": { "$value": "#1A1214" },
    "surface":    { "$value": "#251B1E" },
    "border":     { "$value": "#3D2E32" },
    "text":       { "$value": "#EDE4E6" },
    "textMuted":  { "$value": "#B3A5A9", "$description": "7.1:1 on surface." },
    "brand":      { "$value": "#FF6B7A", "$description": "6.1:1 on surface." },
    "onBrand":    { "$value": "#1A1214", "$description": "Text on brand fills (6.7:1); white fails on the lighter dark brand." },
    "brandLink":  { "$value": "#FF8592", "$description": "Links and alerts (7.2:1 on surface)." },
    "brandSoft":  { "$value": "#3A1D23", "$description": "Selected rows, chips; text on it 12.2:1." },
    "success":    { "$value": "#34D399", "$description": "8.7:1 on surface." },
    "successText":{ "$value": "#6EE7B7" },
    "warning":    { "$value": "#FBBF24", "$description": "10.0:1 on surface." },
    "danger":     { "$value": "#FF6B7A", "$description": "Same as dark brand; always pair with an icon or label." }
  },
  "font": {
    "display": { "$value": "Space Grotesk", "$description": "Numbers and titles. SIL OFL 1.1." },
    "body":    { "$value": "Inter", "$description": "Text and labels. SIL OFL 1.1." }
  },
  "radius": { "card": { "$value": "24px" }, "pill": { "$value": "999px" } },
  "size":   { "touchTarget": { "$value": "44px" } }
}
