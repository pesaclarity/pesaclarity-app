#!/usr/bin/env bash
# Before a push: every commit being pushed needs a Conventional Commits title
# (release-please builds the version and changelog from them), then the full
# tool/check must pass. Skip both in an emergency with: git push --no-verify
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1
. tool/check.env

zero=0000000000000000000000000000000000000000
bad=""
# Git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # deleting a branch
  if [ "$remote_sha" = "$zero" ]; then
    range=("$local_sha" --not --remotes)  # new branch: commits no remote has
  else
    range=("$remote_sha..$local_sha")
  fi
  while read -r sha title; do
    [[ "$title" =~ $COMMIT_TITLE_PATTERN ]] || bad="$bad  $sha $title"$'\n'
  done < <(git log --no-merges --format='%h %s' "${range[@]}")
done

if [ -n "$bad" ]; then
  echo "These commit titles do not follow Conventional Commits:"
  printf '%s' "$bad"
  echo "Start each with a type, e.g. 'feat: add debts screen', 'fix: keep footers out of rows'"
  echo "or 'feat!: change the backup format'. Types: ${COMMIT_TYPES//|/, }."
  echo "Reword them with: git rebase -i <base>  (then 'reword' each one)"
  exit 1
fi

# Git sets these for hooks; Flutter reads its own version with git, so they
# must not point it at this repository.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
exec tool/check
