# Settings for tool/check and the pre-push hook. Plain shell assignments.

# Flutter release the build workflows pin (FLUTTER_VERSION in
# .github/workflows/*.yml). tool/check warns when yours differs.
FLUTTER_VERSION=3.47.8

# Maestro CLI release for the UI flows.
MAESTRO_VERSION=2.11.0

# OSV-Scanner release for the dependency scan (the old workflow used
# google/osv-scanner-action v2.7.0).
OSV_SCANNER_VERSION=2.7.0

# Extra osv-scanner flags. Where api.osv.dev is blocked, scan against the
# downloadable databases instead:
#   OSV_SCANNER_FLAGS="--offline-vulnerabilities --download-offline-databases" tool/check
: "${OSV_SCANNER_FLAGS:=}"

# Quick pure-Dart tests for `tool/check --fast` (about 15 s; the whole suite
# takes a few minutes).
FAST_TESTS="test/core test/config"

# Changes under these paths make the full check run the UI flows (as the old
# UI screenshots workflow did on pull requests that touched them).
UI_PATHS=".maestro tool/run_ui_flows.sh tool/ui_diagnostics.sh tool/install_app.sh"

# Branch that pushed commits are compared with.
BASE_BRANCH=dev

# Conventional Commits title: release-please reads these for the version and
# changelog. "feat!: ..." marks a breaking change.
COMMIT_TYPES="feat|fix|perf|refactor|docs|test|build|ci|chore|revert|style"
COMMIT_TITLE_PATTERN="^($COMMIT_TYPES)(\([a-z0-9-]+\))?!?: [^ ].*\$"
