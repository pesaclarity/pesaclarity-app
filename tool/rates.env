# The public rates service the app fetches exchange rates from (README, Rates).
# Builds read these unless the repository variables of the same names are set.
# ExchangeRate-API's open access asks for this credit, shown with the rates.
PESACLARITY_RATES_URL='https://open.er-api.com/v6/latest/{base}'
PESACLARITY_RATES_SOURCE_NAME='ExchangeRate-API'
PESACLARITY_RATES_SOURCE_URL='https://www.exchangerate-api.com'
